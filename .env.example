# Copy to .env and fill. Never commit .env.

# ---------- NEAR (testnet, D-018) ----------
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.fastnear.com
# Optional second provider; used on retryable failures of the first.
NEAR_RPC_URL_FALLBACK=https://rpc.testnet.near.org
MPC_CONTRACT_ID=v1.signer-prod.testnet
# Contract account = MPC predecessor for derivation (T1 proof now, tradelock later).
PROOF_CONTRACT_ID=tradelock.samuelowen.testnet
PROOF_PATH=tradelock/proof/0

# ---------- Sepolia (chain id 11155111) ----------
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# drpc.org stopped serving Sepolia on its free plan (2026-11-07); 1rpc.io answers with CORS headers.
SEPOLIA_RPC_URL_FALLBACK=https://1rpc.io/sepolia
# Carrier substitution (S-01): deploys the registry, holds MINTER_ROLE, also funds gas in T1. Testnet key only.
SEPOLIA_CARRIER_PK=0x_placeholder
# Supplier EOA that receives the minted eBL and hands it to the derived address. Testnet key only.
SEPOLIA_SUPPLIER_PK=0x_placeholder
# Buyer EOA that receives title from the derived address (address only; no key needed).
SEPOLIA_BUYER_ADDRESS=0x_placeholder

# ---------- TradeTrust ----------
# Official TradeTrust Sepolia TitleEscrowFactory (D-014).
TRADETRUST_FACTORY=0xfcafea839e576967b96ad1FBFB52b5CA26cd1D25
# Filled after `pnpm evm:deploy-registry`.
TRADETRUST_REGISTRY=
# Filled after `pnpm evm:mint` (decimal uint256).
EBL_TOKEN_ID=

# ---------- Deal contract + demo (testnet, D-018) ----------
TRADELOCK_CONTRACT_ID=tradelock.samuelowen.testnet
# Our NEAR Intents Verifier instance (V-16); not deployed until funded.
VERIFIER_ID=intents.samuelowen.testnet
# Test stablecoin (S-07): "Tradelock Test Dollar (testnet, no value)", 6 decimals.
TOKEN_CONTRACT_ID=tusd.samuelowen.testnet
DEMO_BUYER=buyer.samuelowen.testnet
DEMO_SUPPLIER=supplier.samuelowen.testnet
DEMO_ARBITER=arbiter.samuelowen.testnet
# Pays executor actions (signature requests, resume) and tops up the demo buyer with tUSD (token owner).
DEMO_EXECUTOR=samuelowen.testnet
# 1.000000 tUSD
DEMO_AMOUNT=1000000
