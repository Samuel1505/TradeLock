# Copy to web/.env.local. Public values only (sent to the browser).
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC=https://rpc.testnet.fastnear.com
NEXT_PUBLIC_TRADELOCK=tradelock.samuelowen.testnet
NEXT_PUBLIC_VERIFIER=intents.samuelowen.testnet
NEXT_PUBLIC_TOKEN=tusd.samuelowen.testnet
NEXT_PUBLIC_TOKEN_SYMBOL=tUSD
NEXT_PUBLIC_TOKEN_DECIMALS=6
NEXT_PUBLIC_SEPOLIA_RPC=https://ethereum-sepolia-rpc.publicnode.com
# Used when the primary fails (e.g. a rate-limit response without CORS headers). Must send CORS headers.
NEXT_PUBLIC_SEPOLIA_RPC_FALLBACK=https://1rpc.io/sepolia
NEXT_PUBLIC_REGISTRY=0x4e95A0b956d5CADeD0864Df2D26a508257BeC811
# Comma-separated deal ids from the recorded demo run (docs/DEPLOYMENTS.md); empty until recorded.
NEXT_PUBLIC_DEMO_DEALS=0,1,2,3
